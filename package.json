{
  "name": "load-radar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "gen": "node sim/gen.ts --loads 100000 --users 5000 --out out",
    "gen:small": "node sim/gen.ts --loads 8000 --users 300 --hours 2 --out out-small",
    "validate": "node sim/validate.ts out",
    "obs:up": "docker compose up -d",
    "obs:down": "docker compose down",
    "run": "node scripts/run.ts",
    "score": "node scorer/score.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "prom-client": "^15.1.3",
    "undici": "^8.12.3"
  }
}
